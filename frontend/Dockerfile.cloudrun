# GCP-03 / GCP-08 · Imagen del frontend Next.js (standalone) para Cloud Run, de menos de 120 MB.
# Se construye desde frontend/:
#   docker build -f Dockerfile.cloudrun -t evydentia-web .
# Una sola imagen por digest: el entorno NO entra al compilar. APP_ENV y BACKEND_URL se fijan por
# servicio en Cloud Run y el servidor los lee en cada petición (EP-02, GCP-08).

# --- Etapa 1: dependencias de compilación ---
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# --- Etapa 2: compilación standalone ---
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
# Las dependencias de la etapa 1 reemplazan cualquier node_modules del contexto (otro sistema).
COPY --from=deps /app/node_modules ./node_modules
# La configuración de Cloud Run extiende la base: la base pasa a next.config.base.ts y la de
# Cloud Run queda como la configuración activa, solo dentro de esta etapa.
RUN mv next.config.ts next.config.base.ts \
 && sed 's#"./next.config"#"./next.config.base"#' next.config.cloudrun.ts > next.config.ts \
 && rm next.config.cloudrun.ts \
 && npx next build

# --- Etapa 3: ejecución mínima (alpine + Node de apk), sin node_modules completos ni privilegios ---
FROM alpine:3.20 AS runner
RUN apk add --no-cache nodejs \
 && addgroup -S -g 1001 nodejs \
 && adduser -S -u 1001 -G nodejs nextjs
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
