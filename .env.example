# App (FastAPI): rol restringido lopdp_app, sin BYPASSRLS ni propiedad de tablas.
# Su LOGIN/contraseña se fija a mano en la consola SQL de Neon:
#   ALTER ROLE lopdp_app WITH LOGIN PASSWORD '<secreto>';
DATABASE_URL=postgresql+psycopg://lopdp_app:<password>@<host-pooler>/<db>?sslmode=require
# Migraciones (Alembic): rol dueño de las tablas.
MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<host>/<db>?sslmode=require
# Tests: rama test de Neon (dueño; los tests de RLS hacen SET ROLE lopdp_app).
TEST_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<test-host-pooler>/<db>?sslmode=require
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<test-host>/<db>?sslmode=require
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
JWT_SECRET=super_secret_jwt_key_for_local_development_only_9999

# Pre-analisis asistido (pre-llenado de cuestionario). Deshabilitado sin estas variables: no hay respuestas simuladas.
# PREANALISIS_API_KEY=
# PREANALISIS_BASE_URL=
# PREANALISIS_MODEL=

# Asistente de implementación de brechas. La clave permanece solo en FastAPI.
# El modelo recomendado por la documentación vigente es deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
