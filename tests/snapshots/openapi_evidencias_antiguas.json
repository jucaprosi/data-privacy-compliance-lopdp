         ],
         "description": "Contenido textual para que el servidor calcule el SHA-256 (UTF-8). Si llega junto a sha256_hash deben coincidir.",
         "title": "Contenido Texto"
        },
        "contenido_texto_o_hash": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
