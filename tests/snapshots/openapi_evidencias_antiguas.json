        },
        "nombre_archivo": {
         "description": "Nombre del archivo o documento",
         "minLength": 1,
         "title": "Nombre Archivo",
         "type": "string"
        },
        "normativa": {
         "default": "LOPDP",
         "description": "Marco normativo (por defecto LOPDP)",
         "minLength": 1,
         "title": "Normativa",
         "type": "string"
        },
        "propietario_id": {
         "default": "",
