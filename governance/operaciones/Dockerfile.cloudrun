# GCP-01 · Imagen del backend FastAPI para Cloud Run (multi-stage con uv).
# Se construye desde la raíz del repositorio:
#   docker build -f governance/operaciones/Dockerfile.cloudrun -t evydentia-api .
# Los secretos no viajan en la imagen: se leen por ADC (Secret Manager) o variables del servicio.

# --- Etapa 1: dependencias ---
FROM python:3.12-slim AS constructor
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /app
COPY requirements.txt .
RUN uv venv /opt/venv \
 && VIRTUAL_ENV=/opt/venv uv pip install --no-cache -r requirements.txt uvloop httptools

# --- Etapa 2: ejecución, usuario sin privilegios ---
FROM python:3.12-slim
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --no-create-home app
WORKDIR /app
COPY --from=constructor /opt/venv /opt/venv
COPY --chown=app:app . .
USER app
EXPOSE 8080
# Un worker por instancia: Cloud Run escala instancias; la concurrencia la fija el servicio (80).
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT} --workers 1 --loop uvloop --http httptools"]
